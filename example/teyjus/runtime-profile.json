    "profile_source": "module Main where\n\nimport Control.Exception (evaluate)\nimport Control.Monad (replicateM_)\nimport GHC.Clock (getMonotonicTimeNSec)\nimport GHC.Stats (allocated_bytes, getRTSStats)\nimport Hol.V1.Bytecode\nimport System.Environment (getArgs)\nimport System.Mem (performGC)\nimport Text.Printf (printf)\n\nmain :: IO ()\nmain = do\n    [path] <- getArgs\n    replicateM_ 16 $ do\n        source <- readFile path\n        _ <- evaluate (length source)\n        performGC\n        before <- getRTSStats\n        start <- getMonotonicTimeNSec\n        words <- evaluate (either error (length . bytecodeWords) (deserializeBytecode source))\n        end <- getMonotonicTimeNSec\n        performGC\n        after <- getRTSStats\n        printf \"%d %.6f %d\\n\" words (fromIntegral (end - start) / 1000000 :: Double) (allocated_bytes after - allocated_bytes before)\n"
  },
